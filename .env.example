# ==============================================================================
# VIETTORIA HERITAGE FRONTEND - ENVIRONMENT TEMPLATE (.env.example)
# Sao chép tệp này thành .env để cấu hình môi trường:
# cp .env.example .env
# ==============================================================================

# URL API của máy chủ Spring Boot Backend (Local hoặc Production)
VITE_API_BASE_URL=http://localhost:8081/api

# Thư mục tải lên của Backend Spring Boot (Tier 2 Fallback)
VITE_BACKEND_UPLOADS_URL=http://localhost:8081/uploads

# Cấu hình công khai để phân giải URL Cloudinary (không đặt API Secret ở FE)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_BASE_URL=

# Tên ứng dụng & Metadata
VITE_APP_TITLE="VIETTORIA — Phygital Heritage Collectibles"
VITE_APP_EDITION="Phenikaa Student Innovation 2026"
